<div class="card" style="background: #F0FDF4; border: 2px solid #86EFAC; padding: 24px; text-align: center;">
  <div style="font-size: 36px; margin-bottom: 8px;">✅</div>
  <h3 style="font-size: 20px; font-weight: 800; color: #166534; margin-bottom: 6px;">
    <%= (typeof language !== 'undefined' && language === 'hi') ? 'शिकायत सफलतापूर्वक दर्ज कर ली गई है' : 'Grievance Registered Successfully' %>
  </h3>
  <p style="font-size: 13px; color: #15803D; margin-bottom: 16px;">
    <%= (typeof language !== 'undefined' && language === 'hi') ? 'आपकी शिकायत केंद्रीय सहकारी लोकपाल पोर्टल पर अग्रेषित कर दी गई है।' : 'Your complaint has been forwarded to the Central Registrar & Cooperative Ombudsman cell.' %>
  </p>

  <div style="background: #FFFFFF; border: 1px dashed #16A34A; padding: 14px; border-radius: 8px; margin-bottom: 20px; display: inline-block; min-width: 280px;">
    <div style="font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">
      <%= (typeof language !== 'undefined' && language === 'hi') ? 'डिजिटल संदर्भ संख्या (Ticket ID)' : 'Official Reference ID' %>
    </div>
    <div style="font-size: 22px; font-weight: 900; color: #0B3B60; letter-spacing: 0.05em; margin-top: 4px;">
      <%= ticketId %>
    </div>
  </div>

  <div style="text-align: left; background: #FFFFFF; border: 1px solid #DCFCE7; padding: 14px; border-radius: 8px; font-size: 12.5px; color: #334155; margin-bottom: 20px; max-width: 500px; margin-left: auto; margin-right: auto;">
    <div style="margin-bottom: 4px;"><strong><%= (typeof language !== 'undefined' && language === 'hi') ? 'आवेदक:' : 'Applicant:' %></strong> <%= applicantName %> (<%= mobile %>)</div>
    <div style="margin-bottom: 4px;"><strong><%= (typeof language !== 'undefined' && language === 'hi') ? 'समिति:' : 'PACS:' %></strong> <%= pacsName %> (<%= state %>)</div>
    <div style="margin-bottom: 4px;"><strong><%= (typeof language !== 'undefined' && language === 'hi') ? 'श्रेणी:' : 'Category:' %></strong> <%= issueType %></div>
    <div><strong><%= (typeof language !== 'undefined' && language === 'hi') ? 'वैधानिक समय-सीमा:' : 'Statutory Resolution SLA:' %></strong> 30 कार्य दिवस (30 Working Days)</div>
  </div>

  <div style="display: flex; justify-content: center; gap: 12px;">
    <a
      href="/grievance"
      style="padding: 10px 20px; background: #0B3B60; color: #FFFFFF; font-size: 13px; font-weight: 700; border-radius: 6px; text-decoration: none;"
    >
      <%= (typeof language !== 'undefined' && language === 'hi') ? 'नया आवेदन दर्ज करें' : 'File Another Grievance' %>
    </a>
    <a
      href="/"
      style="padding: 10px 20px; background: #FFFFFF; color: #0B3B60; font-size: 13px; font-weight: 700; border: 1px solid #CBD5E1; border-radius: 6px; text-decoration: none;"
    >
      <%= (typeof language !== 'undefined' && language === 'hi') ? 'मुख्य पृष्ठ पर जाएं' : 'Back to Home' %>
    </a>
  </div>
</div>

<div class="container" style="padding-top: 10px;">
  <!-- Section Header -->
  <div style="margin-bottom: 24px;">
    <div style="font-size: 11px; font-weight: 700; color: #D97706; text-transform: uppercase; letter-spacing: 0.05em;">
      <%= (typeof language !== 'undefined' && language === 'hi') ? 'नागरिक एवं पैक्स ई-सेवाएं' : 'Citizen & Cooperative Services' %>
    </div>
    <h2 style="font-size: 24px; font-weight: 800; color: #0B3B60;">
      <%= (typeof language !== 'undefined' && language === 'hi') ? 'पैक्स एवं किसान ई-सेवा केंद्र (CSC Integration)' : 'PACS & Farmer E-Services Integration' %>
    </h2>
    <p style="font-size: 13px; color: #64748B;">
      <%= (typeof language !== 'undefined' && language === 'hi') ? 'कॉमन सर्विस सेंटर (CSC), फसल नुकसान रिपोर्टिंग (72 घंटे), एवं शिकायत निवारण की आधिकारिक प्रक्रिया।' : 'Official statutory processes for crop damage reporting within 72 hours, CRCS grievances, and PACS filings.' %>
    </p>
  </div>

  <!-- Services Grid -->
  <div class="grid-cards">
    <% services.forEach(function(serv) { %>
      <div class="card">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
            <span style="font-size: 10px; background: #FEF3C7; color: #92400E; padding: 2px 8px; border-radius: 4px; font-weight: 700; text-transform: uppercase;">
              <%= serv.category %>
            </span>
            <span style="font-size: 11px; color: #059669; font-weight: 700;">
              <%= serv.officialSource || 'Direct Service' %>
            </span>
          </div>

          <h3 class="card-title">
            <%= (typeof language !== 'undefined' && language === 'hi' && serv.title && serv.title.hi) ? serv.title.hi : (serv.title ? serv.title.en : serv.id) %>
          </h3>

          <p class="card-desc">
            <%= (typeof language !== 'undefined' && language === 'hi' && serv.shortDescription && serv.shortDescription.hi) ? serv.shortDescription.hi : (serv.shortDescription ? serv.shortDescription.en : '') %>
          </p>

          <% if (serv.timeline && (serv.timeline.hi || serv.timeline.en)) { %>
            <div style="background: #F8FAFC; padding: 8px 12px; border-radius: 6px; border: 1px solid #E2E8F0; font-size: 11.5px; margin-bottom: 12px;">
              <div style="font-weight: 700; color: #334155; margin-bottom: 2px;">
                ⏱️ <%= (typeof language !== 'undefined' && language === 'hi') ? 'वैधानिक समय-सीमा:' : 'Statutory Timeline:' %>
              </div>
              <div style="color: #64748B;">
                <%= (typeof language !== 'undefined' && language === 'hi' && serv.timeline.hi) ? serv.timeline.hi : serv.timeline.en %>
              </div>
            </div>
          <% } %>
        </div>

        <div style="display: flex; gap: 8px; align-items: center; border-top: 1px solid #F1F5F9; padding-top: 12px; margin-top: 6px;">
          <a
            href="/?inquire=<%= encodeURIComponent((typeof language !== 'undefined' && language === 'hi' && serv.title && serv.title.hi) ? serv.title.hi + ' के विधिक नियम व आवश्यक दस्तावेज' : (serv.title ? serv.title.en : serv.id) + ' regulatory guidelines and documentation') %>"
            style="flex: 1; padding: 8px; text-align: center; background: #0B3B60; color: #FFFFFF; font-size: 12px; font-weight: 700; border-radius: 6px; text-decoration: none;"
          >
            💬 <%= (typeof language !== 'undefined' && language === 'hi') ? 'परामर्श लें' : 'Consult AI' %>
          </a>
          <% if (serv.officialUrl) { %>
            <a
              href="<%= serv.officialUrl %>"
              target="_blank"
              rel="noopener noreferrer"
              style="padding: 8px 12px; background: #F1F5F9; color: #0B3B60; font-size: 12px; font-weight: 700; border-radius: 6px; text-decoration: none; border: 1px solid #CBD5E1;"
            >
              Portal ↗
            </a>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</div>

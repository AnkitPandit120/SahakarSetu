# GEMINI_API_KEY: Required for Gemini AI API calls and embeddings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Google Drive OAuth 2.0 Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Designated Google Drive Knowledge Base Root Folder ID
DRIVE_KNOWLEDGE_FOLDER_ID=

# Database / Vector Store Connection (Optional: PostgreSQL with pgvector)
DATABASE_URL=

# Session Security
SESSION_SECRET=
